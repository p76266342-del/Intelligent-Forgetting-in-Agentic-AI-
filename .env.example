# ==============================================================================
# INTELLIGENT FORGETTING IN AGENTIC AI - MASTER ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env for local development.

# Application Environment & Security
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Server Settings
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=data/memories.db
# DATABASE_URL: Use sqlite:///data/memories.db for local dev, or postgresql://user:pass@host:5432/dbname for production
DATABASE_URL=sqlite:///data/memories.db

# Firebase Authentication (Server-Side Admin & Verification)
FIREBASE_PROJECT_ID=intelligent-forgetting
FIREBASE_AUTH_DOMAIN=intelligent-forgetting.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intelligent-forgetting.firebasestorage.app
FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON: Alternatively, provide raw JSON or base64 string directly (e.g. for Render env vars)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Gemini AI Inference
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Semantic Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key-if-using-cloud
QDRANT_COLLECTION_NAME=intelligent_forgetting_memories

# Embedding Provider Configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Intelligent Memory Management Limits
MEMORY_MAX_ACTIVE=100
MEMORY_TOKEN_BUDGET=8000
FORGET_THRESHOLD=0.25
ARCHIVE_THRESHOLD=0.45
SUMMARIZE_SIMILARITY_THRESHOLD=0.65
RECENCY_HALF_LIFE_HOURS=72.0
FREQUENCY_SATURATION_COUNT=10.0

# Reinforcement Learning Engine (LinUCB Contextual Bandit)
RL_MODE=shadow
RL_RANDOM_SEED=42
RL_EXPLORATION_RATE=0.1

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC VARIABLES (Next.js Client-Side Only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=intelligent-forgetting.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=intelligent-forgetting
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
