# ==============================================================================
# BACKEND ENVIRONMENT TEMPLATE (FastAPI Service)
# ==============================================================================
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-random-secret
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=data/memories.db
DATABASE_URL=sqlite:///data/memories.db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=intelligent-forgetting
FIREBASE_AUTH_DOMAIN=intelligent-forgetting.firebaseapp.com
FIREBASE_STORAGE_BUCKET=intelligent-forgetting.firebasestorage.app
FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json

# Google Gemini API
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Qdrant Vector Store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-qdrant-cloud-api-key-if-using-cloud
QDRANT_COLLECTION_NAME=intelligent_forgetting_memories

# Embedding Provider
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Cognitive Limits & Thresholds
MEMORY_MAX_ACTIVE=100
MEMORY_TOKEN_BUDGET=8000
FORGET_THRESHOLD=0.25
ARCHIVE_THRESHOLD=0.45
SUMMARIZE_SIMILARITY_THRESHOLD=0.65
RECENCY_HALF_LIFE_HOURS=72.0
FREQUENCY_SATURATION_COUNT=10.0

# Reinforcement Learning
RL_MODE=shadow
RL_RANDOM_SEED=42
RL_EXPLORATION_RATE=0.1
