# ==============================================================================
# FRONTEND ENVIRONMENT TEMPLATE (Next.js Client-Side Only)
# ==============================================================================
# Note: In Next.js, only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never place database credentials, Gemini keys, or service account secrets here!

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=intelligent-forgetting.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=intelligent-forgetting
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
